{
  "title": "Sentinel Reliability Engineering",
  "uid": "sentinel-reliability",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Incidents by terminal state", "targets": [{"expr": "sum by (status) (sentinel_incidents_total)"}], "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6}},
    {"id": 2, "type": "timeseries", "title": "Diagnosis latency", "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(sentinel_diagnosis_seconds_bucket[5m])))"}], "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6}},
    {"id": 3, "type": "timeseries", "title": "Tool calls", "targets": [{"expr": "sum by (tool, status) (rate(sentinel_tool_calls_total[5m]))"}], "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6}},
    {"id": 4, "type": "timeseries", "title": "Model tokens", "targets": [{"expr": "sum by (provider, model) (rate(sentinel_model_tokens_total[5m]))"}], "gridPos": {"x": 0, "y": 6, "w": 12, "h": 7}},
    {"id": 5, "type": "timeseries", "title": "API p95 latency", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(sentinel_http_request_seconds_bucket[5m])))"}], "gridPos": {"x": 12, "y": 6, "w": 12, "h": 7}}
  ]
}
