{
  "title": "Sentinel Reliability Engineering",
  "uid": "sentinel-reliability",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Incidents by terminal state",
      "targets": [{"expr": "sum by (status) (sentinel_incidents_total)"}],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Incident p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, operation) (rate(sentinel_incident_seconds_bucket[5m])))"}],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Diagnosis p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(sentinel_diagnosis_seconds_bucket[5m])))"}],
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(sentinel_http_request_seconds_bucket[5m])))"}],
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tool calls",
      "targets": [{"expr": "sum by (tool, status) (rate(sentinel_tool_calls_total[5m]))"}],
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 7}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tool p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, tool) (rate(sentinel_tool_call_seconds_bucket[5m])))"}],
      "gridPos": {"x": 8, "y": 6, "w": 8, "h": 7}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model calls and tokens",
      "targets": [
        {"expr": "sum by (provider, model, status) (rate(sentinel_model_calls_total[5m]))", "legendFormat": "calls {{provider}}/{{model}} {{status}}"},
        {"expr": "sum by (provider, model) (rate(sentinel_model_tokens_total[5m]))", "legendFormat": "tokens {{provider}}/{{model}}"}
      ],
      "gridPos": {"x": 16, "y": 6, "w": 8, "h": 7}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Estimated model cost (USD)",
      "targets": [{"expr": "sum by (provider, model) (increase(sentinel_model_cost_usd_total[1h]))"}],
      "gridPos": {"x": 0, "y": 13, "w": 6, "h": 7}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Retries",
      "targets": [{"expr": "sum by (component, name) (rate(sentinel_retries_total[5m]))"}],
      "gridPos": {"x": 6, "y": 13, "w": 6, "h": 7}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Approvals and abstentions",
      "targets": [
        {"expr": "sum by (event, decision) (rate(sentinel_approvals_total[5m]))", "legendFormat": "approval {{event}}/{{decision}}"},
        {"expr": "sum by (reason) (rate(sentinel_abstentions_total[5m]))", "legendFormat": "abstain {{reason}}"}
      ],
      "gridPos": {"x": 12, "y": 13, "w": 6, "h": 7}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Errors",
      "targets": [{"expr": "sum by (component, code) (rate(sentinel_errors_total[5m]))"}],
      "gridPos": {"x": 18, "y": 13, "w": 6, "h": 7}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Durable worker outcomes",
      "targets": [{"expr": "sum by (event) (rate(sentinel_work_items_total[5m]))"}],
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 7}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Model p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, provider, model, purpose) (rate(sentinel_model_call_seconds_bucket[5m])))"}],
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 7}
    }
  ]
}
