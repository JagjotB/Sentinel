SENTINEL_DATABASE_URL=sqlite:///./sentinel.db
SENTINEL_ENV=development
SENTINEL_API_TOKEN=sentinel-local-token
SENTINEL_APPROVAL_SECRET=replace-in-production
SENTINEL_MODEL_PROVIDER=deterministic
SENTINEL_MODEL_NAME=sentinel-stub-v1
# Hosted examples (install `.[models]` first):
# SENTINEL_MODEL_PROVIDER=google_vertexai
# SENTINEL_MODEL_NAME=gemini-2.5-flash
# SENTINEL_MODEL_PROVIDER=openai
# SENTINEL_MODEL_NAME=gpt-5-mini
SENTINEL_TOOL_PROVIDER=simulator
SENTINEL_KUBERNETES_NAMESPACE=sentinel-demo
SENTINEL_KUBECTL_CONTEXT=
SENTINEL_PROMETHEUS_URL=http://localhost:9090
SENTINEL_TEMPO_URL=
SENTINEL_GIT_REPOSITORY_PATH=.
SENTINEL_GITHUB_REPOSITORY=
SENTINEL_GITHUB_TOKEN=
SENTINEL_OTLP_ENDPOINT=
SENTINEL_MAX_RUNTIME_SECONDS=300
SENTINEL_MAX_MODEL_TOKENS=60000
SENTINEL_MAX_TOOL_CALLS=40
SENTINEL_MAX_SUBAGENTS=8
SENTINEL_MAX_IDENTICAL_TOOL_CALLS=3
SENTINEL_MAX_COST_USD=1.00
